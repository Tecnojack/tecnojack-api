NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

DATABASE_URL=postgresql://tecnojack:tecnojack@localhost:5432/tecnojack?schema=public

JWT_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d

CORS_ORIGINS=http://localhost:4200
CORS_CREDENTIALS=true

LOG_LEVEL=debug
LOG_PRETTY=true

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

STORAGE_PROVIDER=local
STORAGE_BUCKET=tecnojack
MAIL_PROVIDER=log
UPLOAD_MAX_FILE_SIZE_BYTES=52428800
IMAGE_MAX_WIDTH=12000
FFMPEG_PATH=ffmpeg

