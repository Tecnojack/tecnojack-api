enum EventLifecycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  CLOSED
  ARCHIVED
}

enum EventProductionPhase {
  INQUIRY
  PLANNING
  PRE_PRODUCTION
  PRODUCTION
  POST_PRODUCTION
  REVIEW
  DELIVERY
  FINISHED
}

enum EventDateStatus {
  UNSCHEDULED
  TENTATIVE
  PARTIALLY_CONFIRMED
  CONFIRMED
  POSTPONED
}

enum EventPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EventSessionType {
  MEETING
  PRE_PRODUCTION
  REHEARSAL
  PHOTO_SESSION
  RECORDING
  CEREMONY
  RECEPTION
  PRODUCTION
  POST_PRODUCTION
  DELIVERY
  OTHER
}

enum EventSessionStatus {
  TENTATIVE
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  POSTPONED
}

model EventTypeModel {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique @db.VarChar(64)
  name            String         @db.VarChar(128)
  description     String?        @db.Text
  color           String?        @db.VarChar(16)
  icon            String?        @db.VarChar(64)
  isActive        Boolean        @default(true) @map("is_active")
  sortOrder       Int            @default(0) @map("sort_order")
  defaultTimezone String?        @map("default_timezone") @db.VarChar(64)
  defaultPriority EventPriority  @default(MEDIUM) @map("default_priority")
  templateVersion Int            @default(1) @map("template_version")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  events          EventModel[]

  @@map("event_types")
}

model LocationModel {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(255)
  type                String               @default("VENUE") @db.VarChar(64)
  addressLine         String?              @map("address_line") @db.VarChar(255)
  city                String?              @db.VarChar(128)
  region              String?              @db.VarChar(128)
  countryCode         String?              @map("country_code") @db.Char(2)
  postalCode          String?              @map("postal_code") @db.VarChar(32)
  latitude            Float?
  longitude           Float?
  timezone            String?              @db.VarChar(64)
  contactName         String?              @map("contact_name") @db.VarChar(128)
  contactPhone        String?              @map("contact_phone") @db.VarChar(64)
  accessInstructions  String?              @map("access_instructions") @db.Text
  parkingInstructions String?              @map("parking_instructions") @db.Text
  technicalNotes      String?              @map("technical_notes") @db.Text
  isActive            Boolean              @default(true) @map("is_active")

  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  sessions            EventSessionModel[]

  @@map("locations")
}

model EventModel {
  id                             String               @id @default(uuid()) @db.Uuid
  code                           String               @unique @db.VarChar(32)
  name                           String               @db.VarChar(255)
  slug                           String?              @unique @db.VarChar(255)
  eventTypeId                    String               @map("event_type_id") @db.Uuid
  lifecycleStatus                EventLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  productionPhase                EventProductionPhase @default(INQUIRY) @map("production_phase")
  dateStatus                     EventDateStatus      @default(UNSCHEDULED) @map("date_status")
  priority                       EventPriority        @default(MEDIUM)
  ownerUserId                    String?              @map("owner_user_id") @db.Uuid
  timezone                       String               @default("UTC") @db.VarChar(64)

  estimatedStartAt               DateTime?            @map("estimated_start_at")
  estimatedEndAt                 DateTime?            @map("estimated_end_at")
  confirmedStartAt               DateTime?            @map("confirmed_start_at")
  confirmedEndAt                 DateTime?            @map("confirmed_end_at")

  briefSummary                   String?              @map("brief_summary") @db.Text
  briefObjectives                String?              @map("brief_objectives") @db.Text
  briefAudience                  String?              @map("brief_audience") @db.Text
  briefCreativeDirection         String?              @map("brief_creative_direction") @db.Text
  briefVisualReferences          String?              @map("brief_visual_references") @db.Text
  briefSpecialMoments            String?              @map("brief_special_moments") @db.Text
  briefRestrictions              String?              @map("brief_restrictions") @db.Text
  briefTechnicalRequirements     String?              @map("brief_technical_requirements") @db.Text
  briefAccessibilityRequirements String?              @map("brief_accessibility_requirements") @db.Text
  briefPrivacyRequirements       String?              @map("brief_privacy_requirements") @db.Text
  briefAdditionalNotes           String?              @map("brief_additional_notes") @db.Text

  cancellationReason             String?              @map("cancellation_reason") @db.Text
  cancelledAt                    DateTime?            @map("cancelled_at")
  completedAt                    DateTime?            @map("completed_at")
  closedAt                       DateTime?            @map("closed_at")
  archivedAt                     DateTime?            @map("archived_at")

  createdAt                      DateTime             @default(now()) @map("created_at")
  createdBy                      String?              @map("created_by") @db.Uuid
  updatedAt                      DateTime             @updatedAt @map("updated_at")
  updatedBy                      String?              @map("updated_by") @db.Uuid
  deletedAt                      DateTime?            @map("deleted_at")
  deletedBy                      String?              @map("deleted_by") @db.Uuid

  eventType                      EventTypeModel       @relation(fields: [eventTypeId], references: [id])
  sessions                       EventSessionModel[]
  statusHistory                  EventStatusHistoryModel[]

  @@index([code])
  @@index([lifecycleStatus])
  @@index([productionPhase])
  @@index([dateStatus])
  @@index([deletedAt])
  @@map("events")
}

model EventSessionModel {
  id          String             @id @default(uuid()) @db.Uuid
  eventId     String             @map("event_id") @db.Uuid
  locationId  String?            @map("location_id") @db.Uuid
  type        EventSessionType   @default(OTHER)
  name        String             @db.VarChar(255)
  description String?            @db.Text
  status      EventSessionStatus @default(TENTATIVE)
  dateStatus  EventDateStatus    @default(TENTATIVE) @map("date_status")
  startAt     DateTime?          @map("start_at")
  endAt       DateTime?          @map("end_at")
  timezone    String?            @db.VarChar(64)
  allDay      Boolean            @default(false) @map("all_day")
  sortOrder   Int                @default(0) @map("sort_order")
  notes       String?            @db.Text

  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  event       EventModel         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location    LocationModel?     @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([locationId])
  @@map("event_sessions")
}

model EventStatusHistoryModel {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @map("event_id") @db.Uuid
  statusType    String   @map("status_type") @db.VarChar(64)
  previousValue String   @map("previous_value") @db.VarChar(64)
  newValue      String   @map("new_value") @db.VarChar(64)
  reason        String?  @db.Text
  changedBy     String?  @map("changed_by") @db.Uuid
  changedAt     DateTime @default(now()) @map("changed_at")

  event         EventModel @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_status_history")
}
