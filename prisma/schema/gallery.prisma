enum GalleryStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum GalleryVisibility {
  PUBLIC
  PRIVATE
  PASSWORD_PROTECTED
}

model GalleryModel {
  id                 String                     @id @default(uuid()) @db.Uuid
  code               String                     @unique @db.VarChar(32)
  name               String                     @db.VarChar(255)
  slug               String?                    @unique @db.VarChar(255)
  description        String?                    @db.Text
  eventId            String                     @map("event_id") @db.Uuid
  status             GalleryStatus              @default(DRAFT)
  visibility         GalleryVisibility          @default(PRIVATE)
  password           String?                    @db.VarChar(128)
  coverMediaAssetId  String?                    @map("cover_media_asset_id") @db.Uuid

  allowDownload      Boolean                    @default(false) @map("allow_download")
  allowFavorites     Boolean                    @default(false) @map("allow_favorites")
  allowComments      Boolean                    @default(false) @map("allow_comments")

  publishedAt        DateTime?                  @map("published_at")
  archivedAt         DateTime?                  @map("archived_at")

  createdAt          DateTime                   @default(now()) @map("created_at")
  createdBy          String?                    @map("created_by") @db.Uuid
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  updatedBy          String?                    @map("updated_by") @db.Uuid
  deletedAt          DateTime?                  @map("deleted_at")
  deletedBy          String?                    @map("deleted_by") @db.Uuid

  albums             GalleryAlbumModel[]
  assetReferences    GalleryAssetReferenceModel[]

  @@index([code])
  @@index([eventId])
  @@index([status])
  @@index([deletedAt])
  @@map("galleries")
}

model GalleryAlbumModel {
  id                 String                     @id @default(uuid()) @db.Uuid
  galleryId          String                     @map("gallery_id") @db.Uuid
  name               String                     @db.VarChar(255)
  description        String?                    @db.Text
  coverMediaAssetId  String?                    @map("cover_media_asset_id") @db.Uuid
  sortOrder          Int                        @default(0) @map("sort_order")

  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  gallery            GalleryModel               @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  assetReferences    GalleryAssetReferenceModel[]

  @@index([galleryId])
  @@map("gallery_albums")
}

model GalleryAssetReferenceModel {
  id                 String                     @id @default(uuid()) @db.Uuid
  galleryId          String                     @map("gallery_id") @db.Uuid
  albumId            String?                    @map("album_id") @db.Uuid
  mediaAssetId       String                     @map("media_asset_id") @db.Uuid
  title              String?                    @db.VarChar(255)
  caption            String?                    @db.Text
  sortOrder          Int                        @default(0) @map("sort_order")

  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  gallery            GalleryModel               @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  album              GalleryAlbumModel?         @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@unique([galleryId, mediaAssetId])
  @@index([galleryId])
  @@index([albumId])
  @@index([mediaAssetId])
  @@map("gallery_asset_references")
}
